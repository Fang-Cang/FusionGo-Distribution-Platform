# Local npm development may use mock. Docker Compose defaults to sandbox when
# this file has not been copied to .env.
FCG_MODE=sandbox
# 默认关闭。仅做 UI 演示且明确接受“不会创建上游订单”时才可设为 true。
FCG_SANDBOX_HOTEL_SIMULATION=true
FCG_BASE_URL=https://open.fusionconnectgroup.com
FCG_APP_KEY=
FCG_APP_SECRET=
# Optional product-specific overrides when G-Link and F-Link use different app mappings.
FCG_GLINK_APP_KEY=
FCG_GLINK_APP_SECRET=
FCG_FLINK_APP_KEY=
FCG_FLINK_APP_SECRET=
FCG_ENV=sandbox
# Defaults to .data/fusiongo-<FCG_ENV>.sqlite when omitted.
DATABASE_PATH=/data/fusiongo-sandbox.sqlite
# 本地可使用 32 位以上随机字符串；生产环境必须由密钥管理服务注入。
PII_ENCRYPTION_KEY=
PORT=8787

# Production-only readiness controls. The API refuses to start in production
# until every item below is intentionally configured.
PUBLIC_APP_URL=https://obttest.mongoso.vip
WEBHOOK_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=https://obttest.mongoso.vip
AUTH_MODE=
PRODUCTION_DATABASE_PERSISTENT=false
PAYMENT_MODE=enterprise_credit
PAYMENT_CARD_ENABLED=false
# 卡支付只有在支付服务商已启用 3DS/SCA 后才能在生产开放。
PAYMENT_PSD2_SCA_ENABLED=false
# EPS 确认邮件和在线客服必须展示真实可用的企业联系方式。
CUSTOMER_SUPPORT_URL=
CUSTOMER_SUPPORT_EMAIL=
CUSTOMER_SUPPORT_PHONE=
# Production defaults to blocking non-CNY enterprise-credit orders until an
# FX/settlement policy exists.
ALLOW_FOREIGN_CURRENCY_CREDIT=false

# Order lifecycle scheduler. In production enable this on exactly one worker
# unless a distributed job lock is configured.
ORDER_MAINTENANCE_ENABLED=false
ORDER_MAINTENANCE_INTERVAL_MINUTES=5
UNPAID_ORDER_TIMEOUT_MINUTES=30
ORDER_COMPENSATION_INTERVAL_MINUTES=15
ORDER_MAINTENANCE_BATCH_SIZE=50
MAINTENANCE_API_KEY=
